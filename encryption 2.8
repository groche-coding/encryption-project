def getrotor(alphabet):
    newrotor = []
    while len(newrotor) < len(alphabet):
        x = randint(0,len(alphabet)-1)
        if x not in newrotor:
            newrotor.append(x)
    return newrotor

def getreflector(alphabet):
    newreflector = []
    unswappedlist = alphabet.copy()
    for i in alphabet:
        newreflector.append(-1)
    target = 0
    total = 0
    for i in range(len(alphabet)):
        target += len(alphabet)-i
    target -= len(alphabet)
    while total < target:
        x = 0
        y = 0
        while x == y:
            x = alphabet.index(unswappedlist[randint(0,len(unswappedlist)-1)])
            y = alphabet.index(unswappedlist[randint(0,len(unswappedlist)-1)])
        unswappedlist.remove(alphabet[x])
        unswappedlist.remove(alphabet[y])
        newreflector[y] = x
        newreflector[x] = y
        total = 0
        for i in newreflector:
            total += i
    return newreflector

def enigma(rotors,reflector,alphabet,rotations,pblist):
    text = getinput(" -Input text:\n >\n")
    indexlist = []
    for letter in text:
        index = 0
        for x in range(len(alphabet)):
            if alphabet[x] == letter:
                index = x
                for i in range(len(pblist)):
                    if letter in pblist[i]:
                        index = alphabet.index(pblist[i][abs(pblist[i].index(letter)-1)])
        indexlist.append(index)
    answer = ""
    for n in range(len(indexlist)):
        #####
        #mathematics
        #####
        y = indexlist[n]
        for r in range(len(rotors)):
            y = rotors[r][(y+((n//(len(alphabet)**r))+rotations[r]))%(len(alphabet))]
        y = reflector[y]
        for r in range(len(rotors)-1,-1,-1):
            y = (rotors[r].index(y)- n//(len(alphabet)**(r))+len(alphabet)-rotations[r])% len(alphabet)
        check = False
        #####
        #####
        for i in range(len(pblist)):
            if alphabet[y] in pblist[i]:
                y = alphabet.index(pblist[i][abs(pblist[i].index(alphabet[y])-1)])
                break
        answer += alphabet[y]
    print(f" -\n{answer}")

