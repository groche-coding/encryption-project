def getcommercialrotors(alphabete):
    rotors = [["P","E","Z","U","O","H","X","S","C","V","F","M","T","B","G","L","R","I","N","Q","J","W","A","Y","D","I"],["Z","O","U","E","S","Y","D","K","F","W","P","C","I","Q","X","H","M","V","B","L","G","N","J","R","A","T"],["E","H","R","V","X","G","A","O","B","Q","U","S","I","M","Z","F","L","Y","N","W","K","T","P","D","J","C"]]
    for r in range(len(rotors)):
        for element in range(len(rotors[r])):
            rotors[r][element] = int(alphabete.index(rotors[r][element]))
    return rotors
