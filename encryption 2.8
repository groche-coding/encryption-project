def c1d(arr): # Concatinate (arrays) 1 dimentional (output)
    ans = arr
    if type(ans) == list:
        validation = False
        while validation == False:
            validation = True
            next_list = ans
            ans = []
            for entry in next_list:
                if type(entry) == list:
                    validation = False
                    for element in entry:
                        ans.append(element)
                    meta_data.append(len(entry))## unfinished
                else:
                    ans.append(entry)
    return ans
